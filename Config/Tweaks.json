  "Tweaks": [
    {
      "Id": "Privacy.Telemetry",
      "Name": "Limit Windows Telemetry Policy",
      "Description": "Sets the Windows telemetry policy value where the policy is supported. It does not claim to disable all Microsoft telemetry.",
      "Category": "Privacy",
      "Scope": "System",
      "Provider": "Registry",
      "Risk": "Low",
      "RequiresAdmin": true,
      "Reversible": true,
      "EnabledByDefault": true,
      "RequiresRestorePoint": true,
      "Tags": [
        "telemetry",
        "privacy",
        "registry"
      ],
      "SupportedOS": [
        "Windows 10",
        "Windows 11"
      ],
      "Settings": {
        "RegistryPath": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
        "ValueName": "AllowTelemetry",
        "DesiredValue": 0,
        "PropertyType": "DWord"
      }
    },
    {
